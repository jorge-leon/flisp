#!./test.sh # -*- mode: sh -*-
#
# fLisp test executable and fLisp core
#
# leg20260331, CC0 1.0
#

export FLISP=../fl
export FLISP_INTERACTIVE=0
FLISP_DEBUG=../f.log
unset PREPARE

export FLISP_SIZE=$((20*1024*1024))

tap 154

[ -x $FLISP ]
ok flisp-1 flisp exists and is executable;

IN= OUT="fLisp 0.17α1"
FLISP_INTERACTIVE=1 flisp_expr 1 1; ok flisp-2 empty input succeeds

# reader
IN='(' OUT='#<Error read-incomplete: "unexpected end of stream while reading list", nil>'
flisp_expr; ok reader-1 incomplete sexp error msg

IN='"' OUT='#<Error read-incomplete: "unexpected end of stream while reading string literal", nil>'
flisp_expr; ok reader-2 incomplete string error msg

IN='}' OUT='#<Error invalid-read-syntax: "unexpected character: '"'}'\", nil>"
flisp_expr; ok reader-3-1 unexpected ascii character error msg

IN='ä' OUT='#<Error invalid-read-syntax: "unexpected character: 0xC3'"\", nil>"
flisp_expr; ok reader-3-2 unexpected unicode character error msg

IN="0" OUT='0'
flisp_expr; ok reader-4-1 read integer 0

IN="10" OUT='10'
flisp_expr; ok reader-4-2 read integer 10

IN="010" OUT='8'
flisp_expr; ok reader-4-3 read integer octal 10 is 8

IN="0x10" OUT='16'
flisp_expr; ok reader-4-4 read integer hex 10 is 16

IN="#d.1" OUT='#D3FB999999999999A'
flisp_expr; ok reader-4-5 read double .1 is 0.1 at eof

IN="#d3.14" OUT='#D40091EB851EB851F'
flisp_expr; ok reader-4-6 read double 3.14 is 3.14 at eof

IN="#d7." OUT='#D401C000000000000'
flisp_expr; ok reader-4-7 read double 7. is 7 at eof

IN="#d7. " OUT='#D401C000000000000'
flisp_expr; ok reader-4-8 read double 7. is 7

IN="t" OUT='t'
flisp_expr; ok reader-5 read constant t at eof

IN="nil" OUT='nil'
flisp_expr; ok reader-6 read constant nil

IN='"answer"' OUT='"answer"'
flisp_expr; ok reader-7-1 read ascii string is string

IN='"änßwér"' OUT='"änßwér"'
flisp_expr; ok reader-7-2 read unicode string is string

IN="()" OUT='nil'
flisp_expr; ok reader-8 read empty list

IN="(quote a)" OUT='a'
flisp_expr; ok reader-9 read quote-ed yields symbol

IN="'a" OUT='a'
flisp_expr; ok reader-10 read tick-quoted yields symbol

IN=":a" OUT='a'
flisp_expr; ok reader-11 read colon-quoted yields symbol

IN="'(0 (\"a\" b)) " OUT='(0 ("a" b))'
flisp_expr; ok reader-12 read nested list

IN="'(0 . 1)" OUT='(0 . 1)'
flisp_expr; ok reader-13 read dotted pair

IN="'(0 1 . 2)" OUT='(0 1 . 2)'
flisp_expr; ok reader-14 read dotted list

IN="'(0 1 . " OUT="#<Error read-incomplete: \"unexpected end of stream while reading dotted list\", nil>"
flisp_expr; ok reader-14-1 dotted list w/o end paren \# TODO review - double error

IN="'(0 1 . 2 3)" OUT="#<Error invalid-read-syntax: \"unexpected object at end of dotted list\", nil>"
flisp_expr; ok reader-15 read dotted list with extra element

IN="'(0 1 .)" OUT="#<Error invalid-read-syntax: \"expected object at end of dotted list\", nil>"
flisp_expr; ok reader-16 read dotted list without cdr

IN="'(nil . t)" OUT="(nil . t)"
flisp_expr; ok reader-16-1 read dotted list where nil precedes dot \# TODO fix reader

IN="'(" OUT="#<Error read-incomplete: \"unexpected end of stream while reading list\", nil>"
flisp_expr; ok reader-17 read list without end

# Special forms
IN='(quote)' OUT="#<Error wrong-number-of-arguments: \"expects at least 1 arguments\", #<Primitive quote [1, 1] nil>>"
flisp_expr; ok quote-1 w/o arg error message

IN='(bind)' OUT=nil
flisp_expr; ok bind-1 zero arg gives nil

IN='(bind t)' OUT=nil
flisp_expr; ok bind-2 one arg gives nil

IN="(bind nil var 'val)" OUT=val
flisp_expr; ok bind-3 assignment returns value

IN="(bind nil var 'val) t var" OUT="val"
flisp_expr; ok bind-4 local bind var evaluates to val

IN="(bind t var 'val) t var" OUT="val"
flisp_expr; ok bind-5 global bind var evaluates to val

IN="(bind t var1 3) ((lambda () (bind nil var1 2) t)) var1" OUT=3
flisp_expr; ok bind-6 local bind does not set outer variable.

IN="(bind t var1 3) ((lambda () (bind t var1 2) t)) var1" OUT=2
flisp_expr 3; ok bind-7 global bind does set outer variable.

IN='(progn)' OUT=nil
flisp_expr; ok progn-1 no args evaluate to nil

IN="(progn 'one)" OUT=one
flisp_expr; ok progn-2 one arg evaluates to arg

IN="(progn (write 'first) 'second)" OUT=firstsecond
flisp_expr; ok progn-3 two args evaluate in sequence

# cond
IN='(cond)'  OUT=nil
flisp_expr; ok cond-1 empty cond gives nil

IN='(cond nil)' OUT=nil
flisp_expr; ok cond-2 cond with nil gives nil

IN='(cond ())' OUT=nil
flisp_expr; ok cond-3 cond with empty list gives nil

IN='(cond ("a"))' OUT='"a"'
flisp_expr; ok cond-4 cond with single string predictate gives string

IN='(cond (0))' OUT=0
flisp_expr; ok cond-5 cond with single number predicate gives number

IN='(cond (nil))' OUT=nil
flisp_expr; ok cond-6 cond with single nil predicate gives nil

IN='(cond (t))' OUT=t
flisp_expr; ok cond-7 cond with single t predictate gives t

IN='(cond ("a" "b"))' OUT='"b"'
flisp_expr; ok cond-8 cond with two string list gives second string

IN='(cond nil (t "else"))' OUT='"else"'
flisp_expr; ok cond-9 cond with t clause

IN='(cond nil nil)' OUT=nil
flisp_expr; ok cond-10 cond with nils gives nil

IN='(cond nil ())' OUT=nil
flisp_expr; ok cond-11 cond with nil and empty list gives nil

IN='(cond nil ("a"))' OUT='"a"'
flisp_expr; ok cond-12 cond with last expresion single string list gives its value

IN="(cond nil ((consp (quote (a b)))))" OUT=t
flisp_expr; ok cond-13 cond with last expresion funcall gives result

IN='(cond . "a")' OUT="#<Error wrong-type-argument: \"(cond args) - args is not a list, arg 0\", \"a\">"
flisp_expr; ok cond-14 fail if not called with a cons

IN='(cond "a" ())' OUT="#<Error wrong-type-argument: \"(cond clause ..) - clause is not a list\", \"a\">"
flisp_expr; ok cond-15 fail if clause is not a cons

IN='(cond (nil . "a"))' OUT="#<Error invalid-value: \"read error while reading expression in list\", 'cond'>"
flisp_expr; ok cond-16 fail if clause is cons with car nil \# TODO Fix list reader to allow "(nil . o)"

IN='(cond (t . t))' OUT="#<Error wrong-type-argument: \"(cond (pred action) ..) action is not a list\", (t . t)>"
flisp_expr; ok cond-17 fail if t and clause action is not a list

IN="(cond (42))" OUT="42"
flisp_expr; ok cond-18 cond with only pred returns pred

# lambda
IN='(lambda nil)' OUT="#<Lambda nil>"
flisp_expr; ok lambda-1 arg nil

IN='(lambda a nil)' OUT="#<Lambda a>"
flisp_expr; ok lambda-2 args a nil 

IN='(lambda nil nil)' OUT="#<Lambda nil>"
flisp_expr; ok lambda-3 args nil nil 

IN='(lambda (a b) nil)' OUT="#<Lambda (a b)>"
flisp_expr; ok lambda-4 args a b

IN='(lambda (a . b) nil)' OUT="#<Lambda (a . b)>"
flisp_expr; ok lambda-5 args a . b nil 

IN='(lambda (a b) a b)' OUT="#<Lambda (a b)>"
flisp_expr; ok lambda-6 args nil nil 

IN='((lambda (a b) a b) 0 "a")' OUT='"a"'
flisp_expr; ok lambda-7 apply return b string a

# Time for memory allocator test
#IN='(setq r (lambda args (r args))) (r)' OBJ='out of memory, 48 bytes' ERR='48 bytes'
#flisp_err; ok memory-1 exhausting memory exits with error code

# macro
IN='(macro nil)' OUT='#<Macro nil>'
flisp_expr; ok macro-1 arg nil

IN='(macro a nil)' OUT='#<Macro a>'
flisp_expr; ok macro-2 args a nil

IN='(macro (a b) nil)' OUT='#<Macro (a b)>'
flisp_expr; ok macro-3 args a b

IN='(macro (a . b) nil)' OUT='#<Macro (a . b)>'
flisp_expr; ok macro-4 args a . b

IN='((macro (a b) a b) 0 "a")' OUT='"a"'
flisp_expr; ok macro-5  apply return b string a

# macroexpand-1
IN='(macroexpand-1 nil)' OUT='nil'
flisp_expr; ok macroexpand-1_1  arg nil

IN='(macroexpand-1 (macro a a) b)' OUT='(b)'
flisp_expr; ok macroexpand-1_2  apply return b list b

if false; then
    # Catch/Throw are temporarily retired
    # catch
    IN='(catch nil)' OUT=nil
    flisp_expr; ok catch-1_1  catch nil \# TODO catch/throw to be reworked
    
    IN='(catch t)' OUT=t
    flisp_expr; ok catch-1_2  catch t \# TODO catch/throw to be reworked
    
    IN='(catch (i+ 3 4))' OUT=7
    flisp_expr; ok catch-1_3  catch expr \# TODO catch/throw to be reworked
    
    #IN='(catch (i/))' OUT='(wrong-number-of-arguments "expects at least 2 arguments" #<Primitive i/>)'
    #flisp_expr; ok catch-1_4  catch error
fi

# Primitives

## Objects

IN="(null nil)" OUT="t"
flisp_expr; ok null-1 null nil is t

IN="(null t)" OUT="nil"
flisp_expr; ok null-2 null t is nil

IN="(null 1)" OUT="nil"
flisp_expr; ok null-3 null number is nil

IN="(null 'a)" OUT="nil"
flisp_expr; ok null-4 null symbol is nil

IN='(null "a")' OUT="nil"
flisp_expr; ok null-5 null string is nil

IN="(null lambda)" OUT="nil"
flisp_expr; ok null-6 null lambda is  nil

IN="(null macro)" OUT="nil"
flisp_expr; ok null-7 null macro is  nil

# type-of
IN='(type-of 1)' OUT='type-integer'
flisp_expr; ok type-of-1 type-of 1 is integer

IN='(type-of "a")' OUT='type-string'
flisp_expr; ok type-of-2 type-of \"a\" is string

IN='(type-of nil)' OUT='type-symbol'
flisp_expr; ok type-of-3 type-of nil is symbol

IN="(type-of '(a . b))" OUT='type-cons'
flisp_expr; ok type-of-4 type-of cons is cons

IN='(type-of type-of)' OUT='type-primitive'
flisp_expr; ok type-of-5 type-of type-of is primitive

IN='(type-of (macro ()))' OUT='type-macro'
flisp_expr; ok type-of-6 type-of macro is macro

IN='(type-of *standard-output*)' OUT='type-stream'
flisp_expr; ok type-of-7 type-of output stream is stream

# consp
IN='(consp nil)' OUT='nil'
flisp_expr; ok consp-1  consp nil is nil

IN='(consp 1)' OUT='nil'
flisp_expr; ok consp-2  consp number is nil

IN="(consp 'a)" OUT='nil'
flisp_expr; ok consp-3  consp string is nil

IN="(consp '(t . t))" OUT='t'
flisp_expr; ok consp-4  consp cons is t

IN="(consp '(1  2))" OUT='t'
flisp_expr; ok consp-5  consp list is t

IN="(consp consp)" OUT='nil'
flisp_expr; ok consp-5  consp lambda is nil

IN="(nreverse nil)" OUT="nil"
flisp_expr; ok nreverse-1 nreveverse nil is nil

IN="(nreverse '(1))" OUT="(1)"
flisp_expr; ok nreverse-2 nreveverse single element is single element

IN="(nreverse '(a 1 b 2))" OUT="(2 b 1 a)"
flisp_expr; ok nreverse-3 nreverse four elements is reverse of list

# intern
IN='(type-of (intern "SYMBOL"))' OUT='type-symbol'
flisp_expr; ok intern-1  intern of string is symbol

IN="(symbol-name 'a)" OUT='"a"'
flisp_expr; ok symbol-name-1  symbolname is symbol as string

IN="(same 1 1)" OUT='nil'
flisp_expr; ok same-1_1  same number is false

IN="(same 1 2)" OUT='nil'
flisp_expr; ok same-1_2  different num is nil

IN="(same 1 'a)" OUT='nil'
flisp_expr; ok same-1_3  num other is nil

IN='(same "answer" "answer")' OUT='nil'
flisp_expr; ok same-2_1  same string is nil

IN='(same "answer" "everything")' OUT='nil'
flisp_expr; ok same-2_2  different string is nil

IN='(same "answer" 42)' OUT='nil'
flisp_expr; ok same-2_3  string other is nil

IN="(same 'a 'a)" OUT='t'
flisp_expr; ok same-3_1  same symbol is t

IN="(same 'a same)" OUT='nil'
flisp_expr; ok same-3_2  symbol lambda is nil

IN="(same same same)" OUT='t'
flisp_expr; ok same-3_3  same lambda is t

## Cons'es
IN="(car '(1 2))" OUT='1'
flisp_expr; ok car-1  car returns first element

# Intermezzo
IN="(car 1)" OUT="#<Error wrong-type-argument: \"(car o) - o expected type-cons, got: type-integer\", 1>"
flisp_expr; ok arg_check-1  argument checking '(car 1)' fails

IN="(cdr '(1 2))" OUT='(2)'
flisp_expr; ok cdr-1  cdr returns rest

IN="(cons 1 'a)" OUT="(1 . a)"
flisp_expr; ok cons-1  cons returns dottet pair

# I/O
rm -f _file_
IN='(open "_file_" "w")' OUT=""
flisp_expr
[ -e _file_ ]; ok open-1 create file
rm -f _file_

RESULT=$(echo $PREPARE '(open "empty.lsp")' | $FLISP 2>&1 | grep -E '#<Stream 0X[0-9A-F]{2,16} empty.lsp>')
ok open-2 open file readonly

RESULT=$(echo $PREPARE '(open "<0")' | $FLISP 2>&1 | grep -E "#<Stream 0X[0-9A-F]{2,16} <0>")
ok open-3 open readable file descriptor

RESULT=$(echo $PREPARE '(open ">1")' | $FLISP 2>&1 | grep -E "#<Stream 0X[0-9A-F]{2,17} >1>")
ok open-4 open writeable file descriptor

RESULT=$(echo $PREPARE '(open "any text" "<")' | $FLISP 2>&1 | grep -E "#<Stream 0X[0-9A-F]{2,16} <STRING>")
ok open-5 open memory input stream

RESULT=$(echo $PREPARE '(open "" ">")' | $FLISP 2>&1 | grep -E "#<Stream 0X[0-9A-F]{2,16} >STRING>")
ok open-6 open memory output stream

IN='(close (open "empty.lsp"))' OUT="nil" 
flisp_expr; ok close-1 close file

IN='(close (open ">2"))' OUT="nil"
flisp_expr; ok close-2 close file descriptor

IN='(close (open "any text" "<"))' OUT="nil"
flisp_expr; ok close-3 close memory input stream

IN='(close (open "" ">"))' OUT="nil"
flisp_expr; ok close-4 close memory output stream

IN='(file-info (open "abc" "<"))' OUT='("<STRING" "abc" -1)'
flisp_expr; ok file-info-1 file-info of memory stream contains string

IN='(close (bind t f (open "" ">"))) (file-info f)' OUT='(">STRING" nil nil)'
flisp_expr 2; ok file-info-2 file-info of closed memory stream contains nil

IN='(read (open "1" "<"))' OUT="1"
flisp_expr; ok read-1 read memory input stream \# TODO this works with "x", so it seems to be an issue with scratchpad and integer conversion

IN="(read *standard-input* 'EOF)" OUT="EOF"
flisp_expr; ok read-2 read with eof marker

IN='(eval 1)' OUT='1'
flisp_expr; ok eval-1 eval number is number

OUT=$(printf 'ans\wer"ans\\\\wer"\n' | base64)
T_OUT=$(echo -n '(write "ans\\wer")' | $FLISP 2>&1 | head -1 | base64);
[ "$OUT" = "$T_OUT" ]; ok write-1 write string normally

OUT=$(printf '"ans\\wer""ans\\\\wer"\n' | base64)
T_OUT=$(echo -n '(write "ans\\wer" t)' | $FLISP 2>&1 | head -1 | base64)
[ "$OUT = $T_OUT" ]; ok write-2 write string readably

if false; then
    # Note: Catch/Throw temporarily withdrawn
    # throw
    IN="(throw 'fourty-two \"answer\")" ERR='answer' OBJ=
    flisp_err; ok throw-1_1  throw w/o object \# TODO catch/throw to be revisited
    
    IN="(throw 'fourty-three \"answer\" 1)" ERR='answer' OBJ=1
    flisp_err; ok throw-1_2  throw with object
fi
## Integer arithmetic

IN='(i+ 42 7)' OUT='49' flisp_expr; ok add-1 add 42 7 is 49
IN='(i- 42 7)' OUT='35' flisp_expr; ok minus-1 minus 42 7 is 35
IN='(i* 42 7)' OUT='294' flisp_expr; ok times-1 times 42 7 is 294
IN='(i/ 42 7)' OUT='6' flisp_expr; ok divide-1 divide 42 7 is 6
IN='(i% 42 5)' OUT='2' flisp_expr; ok mod-1 mod 42 5 is 2
IN='(i=0 0)' OUT=t  flisp_expr; ok zerop-1 zero is t
IN='(i=0 7)' OUT=nil flisp_expr; ok zerop-2 7 is nil
IN='(i= 42 7)' OUT='nil' flisp_expr; ok arith-equal-1 arith-equal 42 7 is nil
IN='(i< 7 42)' OUT='t' flisp_expr; ok less-1 less 7 42 is t
IN='(i<= 42 7)' OUT='nil' flisp_expr; ok less-equal-1 less-equal 42 7 is nil
IN='(i> 42 7)' OUT='t' flisp_expr; ok greater-1 greater 42 7 is t
IN='(i>= 7 42)' OUT='nil' flisp_expr; ok greater-equal-1 greater-equal 7 42 is t

## Integer bitwise
IN='(& 7 2)' OUT='2' flisp_expr; ok and-1 and 7 2 is 2
IN='(| 2 5)' OUT='7' flisp_expr; ok or-1 or 2 5 is 7
IN='(^ 2 7)' OUT='5' flisp_expr; ok xor-1  xor 2 7 is 5
IN='(<< 1 3)' OUT='8' flisp_expr; ok left-shift-1 left shift 1 3 is 8
IN='(>> 8 3)' OUT='1' flisp_expr; ok right-shift-1 right shift 8 3 is 1
IN='(~ 7)' OUT='-8' flisp_expr; ok not-1 not 7 is -8

## Strings

IN='(string-append "ans" "wer")' OUT='"answer"'
flisp_expr; ok string-append-1 string append of ans wer is answer
IN='(string-append "answer" "")' OUT='"answer"'
flisp_expr; ok string-append-2  append answer emtpy is answer
IN='(string-append "änß" "wér")' OUT='"änßwér"'
flisp_expr; ok string-append-3 string append of unicode is string

IN='(string-append "" "answer")' OUT='"answer"'
flisp_expr; ok string-append-3  append emtpy answer is anser

IN='(string-compare "a" "a")' OUT="0" flisp_expr; ok string-compare-1 same strings compare 0
IN='(string-compare "a" "b")' OUT="-1" flisp_expr; ok string-compare-2 a less then b
IN='(string-compare "b" "a")' OUT="1" flisp_expr; ok string-compare-3 b greater then a
IN='(string-compare "a" "ä")' OUT="-98" flisp_expr; ok string-compare-4 a less then umlaut a

