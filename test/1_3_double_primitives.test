export FLISP=../fl
export FLISP_PRINT=1
unset FLISP_DEBUG
PREPARE="(extension 'double)"
#PREPARE="(interp-gc-always t)$PREPARE"
#PREPARE="(interp-trace-read t)$PREPARE"
#PREPARE="(interp-trace-primitives t)$PREPARE"

export FLISP_DEBUG=f.log
export FLISP_SIZE=$((20*1024*1024))


tap 1
#IN='(d+ #d2.72 #d3.14)' OUT="#D401770A3D70A3D71"
IN='(d+ #d2.72 #d3.14)' OUT="#d5.860000"
flisp_expr; ok double-plus-1 \# TODO double tests

