#!./test.sh # -*- mode: sh -*-
#
# fLisp - test values expansion in primitives
#
# leg20261014, CC0 1.0
#

export FLISP=../fl
export FLISP_DEBUG=../f.log
export FLISP_PRINT=1
export PREPARE="(interp-gc-always t)"

#export FLISP_SIZE=$((20*1024*1024))

tap 10


# values
IN='(new type-vector 0 (values))' OUT='[]'
flisp_expr; ok values-p-1_1 empty values alone disappears

IN='(new type-vector 0 1 (values))' OUT='[1]'
flisp_expr; ok values-p-1_2 empty values at end disappears

IN='(new type-vector 0 (values) 1)' OUT='[1]'
flisp_expr; ok values-p-1_3 empty values at start disappears

IN='(new type-vector 0 1 (values) 2)' OUT='[1 2]'
flisp_expr; ok values-p-1_4 empty values in between disappears

IN='(new type-vector 0 (values 1))' OUT='[1]'
flisp_expr; ok values-p-2_1 single values alone gets inserted

IN='(new type-vector 0 1 (values 2))' OUT='[1 2]'
flisp_expr; ok values-p-2_2 single values at end gets inserted

IN='(new type-vector 0 (values 1) 2)' OUT='[1 2]'
flisp_expr; ok values-p-2_3 single values at start gets inserted

IN='(new type-vector 0 1 (values 2) 3)' OUT='[1 2 3]'
flisp_expr; ok values-p-2_3 single values in between gets inserted

IN='(new type-vector 0 1 (values 2 3 4) 5)' OUT='[1 2 3 4 5]'
flisp_expr; ok values-p-3 triple values in between gets inserted

IN='(elements (new type-vector 0 1 (values 2 3 4) 5))' OUT='(1 2 3 4 5)'
flisp_expr; ok values-p-4 values reproduce themself
