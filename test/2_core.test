IN='(min)' OUT="(env) expects at least 1 arguments"
flisp_expr; ok min-1 with nil fails

IN='(min "a")' OUT="(min n[ arg ..]) n: expected number, got type-string"
flisp_expr; ok min-2 with not number fails

IN='(min 0)' OUT=0
flisp_expr; ok min-3 with single number yields number

IN='(min 1 2)' OUT=1
flisp_expr; ok min-4 with 'a<b' yields a

IN='(min 2 1)' OUT=1
flisp_expr; ok min-5 with 'a>b' yields b

IN='(min 1 2 3)' OUT=1
flisp_expr; ok min-6 with more then two args

IN='(max)' OUT="(env) expects at least 1 arguments"
flisp_expr; ok max-1 with nil fails

IN='(max "a")' OUT="(max n[ arg ..]) n: expected number, got type-string"
flisp_expr; ok max-2 with not number fails

IN='(max 0)' OUT=0
flisp_expr; ok max-3 with single number yields number

IN='(max 2 1)' OUT=2
flisp_expr; ok max-4 with 'a>b' yields a

IN='(max 1 2)' OUT=2
flisp_expr; ok max-5 with 'a<b' yields b

IN='(max 1 2 3)' OUT=3
flisp_expr; ok max-6 with more then two args

# or
IN='(or)' OUT=nil
flisp_expr; ok or-1 empty or is false

IN='(or t)' OUT=t
flisp_expr; ok or-2 t is t

IN='(or "a")' OUT='"a"'
flisp_expr; ok or-3 not nil is itself

IN='(or t nil)' OUT=t
flisp_expr; ok or-4 t nil is t

IN='(or nil t)' OUT=t
flisp_expr; ok or-5 nil t is t

IN='(or nil 0)' OUT=0
flisp_expr; ok or-6 nil not nil is itself

IN='(or nil nil nil)' OUT=nil
flisp_expr; ok or-7 triple nil is nil

IN='(or nil nil nil "a" "b" nil)' OUT='"a"'
flisp_expr; ok or-8 nil with not nil is first itself

# and
IN='(and)' OUT=t
flisp_expr; ok and-1  no args is t

IN='(and t)' OUT=t
flisp_expr; ok and-2  t is t

IN='(and nil)' OUT=nil
flisp_expr; ok and-3  nil is nil

IN='(and t nil)' OUT=nil
flisp_expr; ok and-4  t nil is nil

IN='(and nil t)' OUT=nil
flisp_expr; ok and-5  nil t is nil

IN='(and nil nil)' OUT=nil
flisp_expr; ok and-6  nil nil is nil

IN='(and t t)' OUT=t
flisp_expr; ok and-7 t t is t

IN='(and "a")' OUT='"a"'
flisp_expr; ok and-8 single not nil is itself

IN='(and t "a")' OUT='"a"'
flisp_expr; ok and-9 not nil at end is itself

IN='(and "a" 0 t)' OUT=t
flisp_expr; ok and-10 triple t is true

IN='(defun aa (p) (and p p)) (aa nil)' OUT=nil
flisp_expr; ok and-11 macro env not working

IN='(join ":" nil)' OUT='""'
flisp_expr; ok join-1 join nil is empty string

IN='(join ":" (list "a"))' OUT='"a"'
flisp_expr; ok join-2 join single list is string

IN='(join ":" (list "a" "b"))' OUT='"a:b"'
flisp_expr; ok join-3 join two elements contains separator

IN='(join ":" (list "a" "b" "c"))' OUT='"a:b:c"'
flisp_expr; ok join-4 join several contains several separators

IN='(join "" (list "a" "b" "c"))' OUT='"abc"'
flisp_expr; ok join-5 join with empty separator concats

IN='(join "nswe" (list "a" "r"))' OUT='"answer"'
flisp_expr; ok join-6 with long separator inserts long separator

# length
IN='(length nil)' OUT=0
flisp_expr; ok length-1 of nil 0

IN="(length '(a b c))" OUT=3
flisp_expr; ok length-2 of triple list is 3

IN="(length (vector a b c d))" OUT=4
echo flisp_expr; ok length-3 of quad vector is 4 \# TODO type-of vector segfaults

IN="(length (car (elements (values 1 2 3 4 5))))" OUT=5
flisp_expr; ok length-4 of five values is 5

# fload
IN='(setq f (open "empty.lsp" "r")) (fload f)' OUT=nil
flisp_expr; ok fload-1 load empty file

IN='(setq f (open "one_word.lsp" "r")) (fload f)' OUT='"one_word"'
flisp_expr; ok fload-2 load file with one word

# load
IN='(load "empty.lsp")' OUT=nil
flisp_expr; ok load-1 load empty file

IN='(load "one_word.lsp")' OUT='"one_word"'
flisp_expr; ok load-2 load file with one word

# provide
IN="(provide)" OUT="(nil core)"
flisp_expr; ok provide-1 providing nothing adds nil
IN="(provide 'a)" OUT="(a core)"
flisp_expr; ok provide-2 providing feature a prepends a to features
IN="(provide 'a 'b)" OUT="(a core)"
flisp_expr; ok provide-3 providing features a and subfeature b only prepends a to features

# require
IN="(require)" OUT="(env) expects at least 1 arguments"
flisp_expr; ok require-1 requiring nothing errs

IN="(require '_no_file)" OUT="nil"
flisp_expr; ok require-2 requiring not existing features returns nil

IN="(require 'core)" OUT="core"
flisp_expr; ok require-3 requiring existing feature returns feature

IN="(require 'flisp)" OUT="flisp"
flisp_expr; ok require-4 requiring new feature returns feature
