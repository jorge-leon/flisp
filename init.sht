;; -*-Lisp-*-
;;
;; fLisp startup file

$(cat core.lsp)

;;; REPL
(setq *error-output* (open ">2"))

(defun repl-princ s  (princ (concat s)))
(defun repl-eprinc s (princ (concat s) *error-output*))

(defun repl-print-result (result)
  (print result)
  (princ "\n")
  result )

(defun repl-print-error (err)
  (print err *error-output*)
  (princ "\n" *error-output*) )

(defun repl (result)
  (when (fttyp) (repl-princ "> "))
  (let ((e (read)))
    (if (eq type-error (type-of e))
	(if (same (car (objects e)) end-of-file)
	    (when (fttyp) (princ "\n") e)
	    (repl (repl-print-error e)) )
	(let ((r (eval e)))
	  (if (same type-error (type-of r))
	      (repl (repl-print-error r))
	      (repl (repl-print-result r)) )))))

(defun repl-rcfile ()
  (let ((rcfile (concat (getenv "HOME") "/" ".config/flisp/init.lsp")))
    (on-error (load rcfile)
	      (lambda (e)
		(when (fttyp)
		  (repl-eprinc "Failed to load user init file: "rcfile"\n")
		  (repl-print-error e) )))))

;;; load all files on the commandline
(defun repl-getopts (opts result)
  (unless (eq type-of result type-error)
    (repl-getopts (cdr opts) (load (car opts))) ))

(defun repl-args ()
  (on-error (getopts argv nil)
	    (lambda (e)
	      (repl-eprinc "Error parsing commandline..\n")
	      (repl-print-error e) )))
(progn
  (interp :output (open ">1" "w"))
  (if argv (repl-args)
      (interp :input (open "<0"))
      (when (fttyp) (repl-princ (interp :version)"\n"))
      (repl-rcfile)
      (when (fttyp) (repl-princ "exit with C-d\n"))
      (repl nil) ))
